# Copy to secrets.toml and fill in values.
# secrets.toml is gitignored - never commit real secrets.

# API backend URL (required - Streamlit fetches all data from here)
[api]
base_url = "https://your-server.example.com"
timeout = 30

# Admin contact info (used in UI text)
[admins]
rechnung = "Name für Abrechnungsfragen"
technik = "Name für technische Fragen"
